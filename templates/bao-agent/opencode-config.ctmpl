{{- $router_field := env "AGENT_SANDBOX_ROUTER_KEY_FIELD" -}}
{{- $tracker := eq (env "AGENT_TRACKER_ACCESS") "true" -}}
{{- $model := "" -}}
{{- if eq (env "AGENT_TOOL") "opencode-local" }}{{ $model = "medium" }}{{ end -}}
{{- if eq (env "AGENT_TOOL") "opencode-qwen" }}{{ $model = "qwen4-max-preview" }}{{ end -}}
{{- $context_tokens := env "AGENT_OPENCODE_CONTEXT_TOKENS" -}}
{{- $output_tokens := env "AGENT_OPENCODE_OUTPUT_TOKENS" -}}
{{- $limit := "" -}}
{{- if and (eq (env "AGENT_TOOL") "opencode-local") (regexMatch "^[1-9][0-9]*$" $context_tokens) }}{{ if not (regexMatch "^[1-9][0-9]*$" $output_tokens) }}{{ $output_tokens = "8192" }}{{ end }}{{ $limit = printf `,"limit":{"context":%s,"output":%s}` $context_tokens $output_tokens }}{{ end -}}
{{- if or (eq (env "AGENT_TOOL") "opencode") (eq (env "AGENT_TOOL") "opencode-local") (eq (env "AGENT_TOOL") "opencode-zai") (eq (env "AGENT_TOOL") "opencode-qwen") -}}
{
  {{- if $router_field }}
  {{- if $model }}
  "model":"agent-router/{{ $model }}",
  {{- end }}
  "provider":{"agent-router":{"npm":"@ai-sdk/openai-compatible","name":"Agent Router","options":{"baseURL":"{env:AGENT_ROUTER_BASE_URL}","apiKey":"{env:AGENT_ROUTER_KEY}","headers":{"User-Agent":"dryvist-sandbox","x-opencode-session":"{env:AGENT_RUN_ID}"}}{{ if $model }},"models":{"{{ $model }}":{"name":"{{ $model }}"{{ $limit }}}}{{ end }}}}{{ if $tracker }},{{ end }}
  {{- end }}
  {{- if $tracker }}
  "mcp":{
    "vikunja":{"type":"local","command":[{{ env "AGENT_MCP_VIKUNJA_COMMAND" | toJSON }}],"environment":{"VIKUNJA_URL":"{env:VIKUNJA_URL}","VIKUNJA_API_TOKEN":"{env:VIKUNJA_API_TOKEN}"}},
    "zammad":{"type":"local","command":[{{ env "AGENT_MCP_ZAMMAD_COMMAND" | toJSON }}{{ range env "AGENT_MCP_ZAMMAD_ARGS" | parseJSON }},{{ . | toJSON }}{{ end }}],"environment":{"ZAMMAD_URL":"{env:ZAMMAD_URL}","ZAMMAD_HTTP_TOKEN":"{env:ZAMMAD_HTTP_TOKEN}"}}
  }
  {{- end }}
}
{{- end -}}
