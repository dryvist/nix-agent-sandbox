#!/usr/bin/env bash
# Test stand-in for docker: records every call in $STUB_DIR and answers the
# way the daemon would for the calls agent-dispatch makes.
set -euo pipefail

{
  printf 'docker'
  printf ' %q' "$@"
  printf '\n'
} >>"$STUB_DIR/argv.log"
echo "docker $1" >>"$STUB_DIR/calls.log"

next() {
  local f="$STUB_DIR/n.$1" n
  n=$(($(cat "$f" 2>/dev/null || echo 0) + 1))
  echo "$n" >"$f"
  echo "$n"
}

case "$1" in
  ps)
    if [ -n "${STUB_FIX_CONTAINERS:-}" ]; then
      printf '%s\n' "$STUB_FIX_CONTAINERS"
    elif [ -n "${STUB_FIX_RUNNING_COUNT:-}" ]; then
      for ((i = 0; i < STUB_FIX_RUNNING_COUNT; i++)); do printf 'fix-container-%s\n' "$i"; done
    fi
    ;;
  create)
    shift
    printf '%s\n' "$@" >"$STUB_DIR/create.$(next create)"
    echo "${STUB_CID:-cid0123}"
    ;;
  cp)
    if [ "$2" = - ]; then
      cat >"$STUB_DIR/cp.$(next cp).tar"
    elif [[ "$2" == *"/.agent-fix" ]] && [ -n "${STUB_FIX_DIR:-}" ]; then
      tar -C "${STUB_FIX_DIR%/*}" -cf - "${STUB_FIX_DIR##*/}"
    elif [[ "$2" == *"/.agent-fix" ]]; then
      echo "Error response from daemon: Could not find the file" >&2
      exit 1
    elif [ -n "${STUB_PR_URL:-}" ]; then
      d=$(mktemp -d)
      printf '%s\n' "$STUB_PR_URL" >"$d/.agent-pr-url"
      tar -C "$d" -cf - .agent-pr-url
    else
      echo "Error response from daemon: Could not find the file" >&2
      exit 1
    fi
    ;;
  wait)
    # The container exits on wait call number STUB_WAIT_CALLS (default 1);
    # earlier calls block until the dispatcher's slice timeout kills them.
    if [ "$(next wait)" -lt "${STUB_WAIT_CALLS:-1}" ]; then exec sleep 60; fi
    echo "${STUB_EXIT:-0}"
    ;;
  run)
    # Only the publisher's gitleaks scan calls `docker run`.
    [[ " $* " == *" --network none "* && " $* " == *" --entrypoint gitleaks "* ]] || exit 125
    for arg in "$@"; do
      if [[ $arg == *:/scan:ro ]]; then
        (cd "${arg%:/scan:ro}" && find . -type f | sort) >"$STUB_DIR/scan.list"
      fi
    done
    if [ -n "${STUB_GITLEAKS_FAIL:-}" ]; then exit 1; fi
    ;;
  attach) ;;
  inspect)
    case "$3" in
      *Running*) echo "${STUB_RUNNING:-false}" ;;
      *Status*) echo "${STUB_STATUS:-exited}" ;;
      *ExitCode*) echo "${STUB_EXIT:-0}" ;;
    esac
    ;;
esac
