#!/usr/bin/env bash
# Test stand-in for curl: stores each request (line, headers, body) in
# $STUB_DIR/http.<n>.* and answers as OpenBao, GitHub, Vikunja or ntfy would.
set -euo pipefail

{
  printf 'curl'
  printf ' %q' "$@"
  printf '\n'
} >>"$STUB_DIR/argv.log"

method=GET url="" headers="" body="" out=/dev/stdout write_out="" fail_with_body=0
while [ $# -gt 0 ]; do
  case "$1" in
    -X)
      method=$2
      shift 2
      ;;
    -o)
      out=$2
      shift 2
      ;;
    -w | --write-out)
      write_out=$2
      shift 2
      ;;
    --fail-with-body)
      fail_with_body=1
      shift
      ;;
    -H)
      if [[ $2 == @* ]]; then headers+=$(cat "${2#@}")$'\n'; else headers+=$2$'\n'; fi
      shift 2
      ;;
    --data-binary)
      if [[ $2 == @* ]]; then body=$(cat "${2#@}"); else body=$2; fi
      shift 2
      ;;
    --max-time)
      shift 2
      ;;
    -*) shift ;;
    *)
      url=$1
      shift
      ;;
  esac
done

f="$STUB_DIR/n.http"
n=$(($(cat "$f" 2>/dev/null || echo 0) + 1))
echo "$n" >"$f"
echo "$method $url" >"$STUB_DIR/http.$n.req"
printf '%s' "$headers" >"$STUB_DIR/http.$n.hdr"
printf '%s' "$body" >"$STUB_DIR/http.$n.body"
vault=$(sed -n 's/^X-Vault-Token: //p' <<<"$headers")
echo "curl $method $url${vault:+ token=$vault}" >>"$STUB_DIR/calls.log"

# --fail-with-body: an error answer still writes its body, then exits 22.
code=0 http_code=200
case "$url" in
  */v1/auth/approle/login)
    if [ -n "${STUB_LOGIN_FAIL:-}" ]; then
      resp='{"errors":["invalid role or secret ID"]}' code=22
    else
      resp="{\"auth\":{\"client_token\":\"s.tok$n\",\"lease_duration\":${STUB_LEASE:-900}}}"
    fi
    ;;
  */v1/auth/token/renew-self)
    if [ -n "${STUB_RENEW_FAIL:-}" ]; then
      resp='{"errors":["permission denied"]}' code=22
    else
      resp="{\"auth\":{\"lease_duration\":${STUB_RENEW_LEASE:-${STUB_LEASE:-900}}}}"
    fi
    ;;
  */v1/secret/data/apps/open-llm) resp=$(cat "$STUB_DIR/bucket.json") ;;
  */v1/github-agents/token)
    if [ -n "${STUB_MINT_FAIL:-}" ]; then
      resp='{"errors":["1 error occurred:\n\t* permission denied\n\n"]}' code=22
    else
      resp='{"data":{"token":"ghs_minted_secret"}}'
    fi
    ;;
  */installation/repositories)
    resp="{\"total_count\":${STUB_SCOPE_COUNT:-1},\"repositories\":[{\"full_name\":\"${STUB_SCOPE_REPO:-dryvist/nix-ai}\"}]}"
    ;;
  */repos/*/rules/branches/*)
    if [ -n "${STUB_BRANCH_UNPROTECTED:-}" ]; then
      resp='[{"type":"deletion"}]'
    else
      resp='[{"type":"deletion"},{"type":"pull_request","parameters":{}}]'
    fi
    ;;
  */repos/*/contents/*)
    if [ -n "${STUB_CONTENTS_404:-}" ]; then
      http_code=404
      resp='{"message":"Not Found"}'
    else
      resp=$(jq -cn --arg c "${STUB_BASE_CONTENT:-}" '{type: "file", encoding: "base64", content: $c}')
    fi
    ;;
  */repos/*/git/ref/heads/*)
    if [ "${STUB_FIX_BRANCH_EXISTS:-}" = 1 ]; then
      resp='{"ref":"refs/heads/fix","object":{"sha":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}'
    else
      http_code=404
      resp='{"message":"Not Found"}'
    fi
    ;;
  */repos/*/git/refs)
    resp='{"ref":"refs/heads/fix"}'
    ;;
  */repos/*/pulls)
    resp=$(jq -cn --arg u "${STUB_FIX_PR_URL:-https://github.com/${STUB_SCOPE_REPO:-dryvist/nix-ai}/pull/8}" '{html_url: $u}')
    ;;
  */graphql)
    if [ -n "${STUB_HEAD_MOVED:-}" ]; then
      resp='{"errors":[{"message":"Expected branch head to match expectedHeadOid"}]}'
    else
      resp='{"data":{"createCommitOnBranch":{"commit":{"oid":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}}}'
    fi
    ;;
  */repos/*)
    if [ -n "${STUB_REPO_PRIVATE:-}" ]; then
      resp="{\"private\":true,\"visibility\":\"private\",\"default_branch\":\"${STUB_DEFAULT_BRANCH:-main}\"}"
    else
      resp="{\"private\":false,\"visibility\":\"public\",\"default_branch\":\"${STUB_DEFAULT_BRANCH:-main}\"}"
    fi
    ;;
  *) resp='{}' ;;
esac
printf '%s\n' "$resp" >"$out"
[ "$http_code" -lt 400 ] || [ "$fail_with_body" = 0 ] || code=22
if [ -n "$write_out" ]; then
  printf '%s' "${write_out//\%\{http_code\}/$http_code}"
fi
exit "$code"
