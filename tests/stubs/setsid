#!/usr/bin/env bash
# Test stand-in for setsid: runs the waiter in the foreground so a test sees
# the finished run, or drops it (STUB_NO_WAITER) to leave the run in flight.
set -euo pipefail

{
  printf 'setsid'
  printf ' %q' "$@"
  printf '\n'
} >>"$STUB_DIR/argv.log"

[ "$1" != -f ] || shift
if [ -n "${STUB_NO_WAITER:-}" ]; then
  cat >/dev/null
  if [ "${2:-}" = __job ]; then
    rmdir "$AGENT_DISPATCH_STATE_DIR/${3:-}/manager" 2>/dev/null || true
  fi
  exit 0
fi
"$@" <&0 &
pid=$!
printf '%s\n' "$pid" >"$STUB_DIR/waiter.pid"
if [ -n "${STUB_KEEP_WAITER:-}" ]; then exit 0; fi

for ((i = 0; i < 500; i++)); do
  if grep -q 'curl POST https://ntfy.test/ai-jobs' "$STUB_DIR/calls.log"; then
    for ((j = 0; j < 50; j++)); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.01
    done
    kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    exit 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" || exit $?
    exit 0
  fi
  sleep 0.01
done
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true
exit 1
